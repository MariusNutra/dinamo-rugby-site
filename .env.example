# Contul de admin NU se configureaza de aici. Parola sta in tabelul `User`
# din baza de date, verificata cu bcrypt in app/api/auth. Pana la 13.08.2026
# fisierul asta cerea ADMIN_USERNAME si ADMIN_PASSWORD_HASH, pe care codul nu
# le citea nicaieri — cine schimba parola de acolo credea ca a schimbat-o.
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UPLOAD_DIR=/var/www/rugby-dinamo/uploads

# Email IMAP (for unread count in admin)
EMAIL_IMAP_HOST=mail.dinamorugby.ro
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=contact@dinamorugby.ro
EMAIL_IMAP_PASS=
